<?xml version="1.0" encoding="utf-8" ?>
<Patch>

  <!-- Other mods' research that optionally requires Progression: Furniture requires this fork instead -->
  <Operation Class="PatchOperationAttributeSet">
    <success>Always</success>
    <xpath>Defs//*[translate(@MayRequire,'ABCDEFGHIJKLMNOPQRSTUVWXYZ','abcdefghijklmnopqrstuvwxyz')="ferny.progressionfurniture"]</xpath>
    <attribute>MayRequire</attribute>
    <value>cruesoe.progressionlessfurniture</value>
  </Operation>

</Patch>
