<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationSequence">
    <operations>
      <li Class="PatchOperationRemove">
        <success>Always</success>
        <xpath>/Defs/ThingDef[defName="Door"]/researchPrerequisites</xpath>
      </li>
      <li Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="Door"]</xpath>
        <value>
          <researchPrerequisites Inherit="False">
            <li>Ferny_Column</li>
          </researchPrerequisites>
        </value>
      </li>
    </operations>
  </Operation>
  <Operation Class="PatchOperationSequence">
    <operations>
      <li Class="PatchOperationRemove">
        <success>Always</success>
        <xpath>/Defs/ThingDef[defName="OrnateDoor"]/researchPrerequisites</xpath>
      </li>
      <li Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="OrnateDoor"]</xpath>
        <value>
          <researchPrerequisites Inherit="False">
            <li>Ferny_WindowWall</li>
            <li>Ferny_Column</li>
          </researchPrerequisites>
        </value>
      </li>
    </operations>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName="OrnateDoor"]/label</xpath>
    <value>
      <label>ornate door (1x2)</label>
    </value>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <success>Always</success>
    <xpath>/Defs/ResearchProjectDef[defName="Autodoors"]/prerequisites/@IsNull</xpath>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ResearchProjectDef[defName="Autodoors"]/prerequisites</xpath>
    <match Class="PatchOperationAdd">
      <xpath>/Defs/ResearchProjectDef[defName="Autodoors"]/prerequisites</xpath>
      <value>
        <li>Ferny_Column</li>
      </value>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>/Defs/ResearchProjectDef[defName="Autodoors"]</xpath>
      <value>
        <prerequisites>
          <li>Ferny_Column</li>
        </prerequisites>
      </value>
    </nomatch>
  </Operation>
</Patch>
