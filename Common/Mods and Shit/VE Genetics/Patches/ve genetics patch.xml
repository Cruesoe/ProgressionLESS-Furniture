<?xml version='1.0' encoding='utf-8'?>
<Patch>
	<Operation Class="PatchOperationSequence">
		<success>Always</success>
		<operations>
			<li Class="PatchOperationRemove">
				<xpath>/Defs/ThingDef[@Name="GR_ArtBaseGround"]/recipeMaker</xpath>
			</li>
			<li Class="PatchOperationConditional">
				<xpath>/Defs/ThingDef[@Name="GR_ArtBaseGround"]/designationCategory</xpath>
				<match Class="PatchOperationReplace">
					<xpath>/Defs/ThingDef[@Name="GR_ArtBaseGround"]/designationCategory</xpath>
					<value>
						<designationCategory>Ferny_DecoRugs</designationCategory>
					</value>
				</match>
				<nomatch Class="PatchOperationAdd">
					<xpath>/Defs/ThingDef[@Name="GR_ArtBaseGround"]</xpath>
					<value>
						<designationCategory>Ferny_DecoRugs</designationCategory>
					</value>
				</nomatch>
			</li>
			<li Class="PatchOperationConditional">
				<xpath>/Defs/ThingDef[@Name="GR_ArtBaseGround"]/terrainAffordanceNeeded</xpath>
				<match Class="PatchOperationReplace">
					<xpath>/Defs/ThingDef[@Name="GR_ArtBaseGround"]/terrainAffordanceNeeded</xpath>
					<value>
						<terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
					</value>
				</match>
				<nomatch Class="PatchOperationAdd">
					<xpath>/Defs/ThingDef[@Name="GR_ArtBaseGround"]</xpath>
					<value>
						<terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
					</value>
				</nomatch>
			</li>
		</operations>
	</Operation>
</Patch>