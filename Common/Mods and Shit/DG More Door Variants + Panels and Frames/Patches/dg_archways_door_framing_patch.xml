<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationSequence">
    <operations>
      <li Class="PatchOperationRemove">
        <success>Always</success>
        <xpath>/Defs/ThingDef[defName="MDV_WoodyArchway" or defName="MDV_StonyArchway"]/researchPrerequisites</xpath>
      </li>
      <li Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="MDV_WoodyArchway" or defName="MDV_StonyArchway"]</xpath>
        <value>
          <researchPrerequisites Inherit="False">
            <li>Ferny_WindowWall</li>
            <li MayRequire="oskarpotocki.vfe.tribals">VFET_Furniture</li>
          </researchPrerequisites>
        </value>
      </li>
    </operations>
  </Operation>
</Patch>
