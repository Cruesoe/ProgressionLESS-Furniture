<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<Operation Class="PatchOperationConditional">
		<xpath>/Defs/ResearchProjectDef[defName="HeavyBridges"]/prerequisites</xpath>
		<match Class="PatchOperationReplace">
			<success>Always</success>
			<xpath>/Defs/ResearchProjectDef[defName="HeavyBridges"]/prerequisites</xpath>
			<value>
				<prerequisites>
					<li>Smithing</li>
					<li>Ferny_Floors</li>
					<li MayRequire="vanillaexpanded.vfesecurity,ferny.progressionarsenal">Ferny_Platform</li>
				</prerequisites>
			</value>
		</match>
		<nomatch Class="PatchOperationAdd">
			<success>Always</success>
			<xpath>/Defs/ResearchProjectDef[defName="HeavyBridges"]</xpath>
			<value>
				<prerequisites>
					<li>Smithing</li>
					<li>Ferny_Floors</li>
					<li MayRequire="vanillaexpanded.vfesecurity,ferny.progressionarsenal">Ferny_Platform</li>
				</prerequisites>
			</value>
		</nomatch>
	</Operation>

	<!-- Fortified walls can't be built; keep them from inheriting the vanilla wall's research (VFE Tribals' Construction) -->
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[@Name="AncientFortifiedWall"]/researchPrerequisites</xpath>
		<match Class="PatchOperationReplace">
			<xpath>Defs/ThingDef[@Name="AncientFortifiedWall"]/researchPrerequisites</xpath>
			<value>
				<researchPrerequisites Inherit="False" />
			</value>
		</match>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[@Name="AncientFortifiedWall"]</xpath>
			<value>
				<researchPrerequisites Inherit="False" />
			</value>
		</nomatch>
	</Operation>
</Patch>
