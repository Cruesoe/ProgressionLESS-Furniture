<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Toxifier lamps need Toxifier generator plus the electric research their lamp type needs -->
  <Operation Class="PatchOperationSequence">
    <operations>
      <li Class="PatchOperationRemove">
        <success>Always</success>
        <xpath>/Defs/ThingDef[defName="ToxLamps_StandingLamp" or defName="ToxLamps_SunLamp" or defName="ToxLamps_FloorLamp" or defName="ToxLamps_WallLamp" or defName="ToxLamps_FloodLight"]/researchPrerequisites</xpath>
      </li>
      <li Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="ToxLamps_StandingLamp" or defName="ToxLamps_SunLamp" or defName="ToxLamps_FloorLamp" or defName="ToxLamps_WallLamp"]</xpath>
        <value>
          <researchPrerequisites Inherit="False">
            <li>ToxifierGenerator</li>
            <li>Ferny_StandingLamp</li>
          </researchPrerequisites>
        </value>
      </li>
      <li Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="ToxLamps_FloodLight"]</xpath>
        <value>
          <researchPrerequisites Inherit="False">
            <li>ToxifierGenerator</li>
            <li>ColoredLights</li>
          </researchPrerequisites>
        </value>
      </li>
    </operations>
  </Operation>
</Patch>
