          <xpath>/Defs/ThingDef[defName="GR_WolfRug"]/researchPrerequisites</xpath>
          <value>
            <researchPrerequisites>
              <li>VFE_Res_Rugs</li>
            </researchPrerequisites>
          </value>
        </match>
        <nomatch Class="PatchOperationAdd">
          <xpath>/Defs/ThingDef[defName="GR_WolfRug"]</xpath>
          <value>
            <researchPrerequisites>
              <li>VFE_Res_Rugs</li>
            </researchPrerequisites>
          </value>
        </nomatch>
      </li>
      <li Class="PatchOperationConditional">
        <xpath>/Defs/ThingDef[defName="GR_MuffaloRug"]/researchPrerequisites</xpath>
        <match Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="GR_MuffaloRug"]/researchPrerequisites</xpath>
          <value>
            <researchPrerequisites>
              <li>VFE_Res_Rugs</li>
            </researchPrerequisites>
          </value>
        </match>
        <nomatch Class="PatchOperationAdd">
          <xpath>/Defs/ThingDef[defName="GR_MuffaloRug"]</xpath>
          <value>
            <researchPrerequisites>
              <li>VFE_Res_Rugs</li>
            </researchPrerequisites>
          </value>
        </nomatch>
      </li>
      <!-- The scaly bear rug only exists when VE Genetics loads its Dinosauria folder -->
      <li Class="PatchOperationConditional">
        <xpath>/Defs/ThingDef[defName="GR_ScalyBearRug"]</xpath>
        <match Class="PatchOperationConditional">
          <xpath>/Defs/ThingDef[defName="GR_ScalyBearRug"]/researchPrerequisites</xpath>
          <match Class="PatchOperationReplace">
            <xpath>/Defs/ThingDef[defName="GR_ScalyBearRug"]/researchPrerequisites</xpath>
            <value>
              <researchPrerequisites>
                <li>VFE_Res_Rugs</li>
              </researchPrerequisites>
            </value>
          </match>
          <nomatch Class="PatchOperationAdd">
            <xpath>/Defs/ThingDef[defName="GR_ScalyBearRug"]</xpath>
            <value>
              <researchPrerequisites>
                <li>VFE_Res_Rugs</li>
              </researchPrerequisites>
            </value>
          </nomatch>
        </match>
      </li>
    </operations>
  </Operation>
</Patch>
