<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- The plain embrasure builds with Carpentry; the rustic embrasure stays with the other ReBuild walls -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="CE_Embrasure"]/researchPrerequisites</xpath>
    <match Class="PatchOperationReplace">
      <xpath>/Defs/ThingDef[defName="CE_Embrasure"]/researchPrerequisites</xpath>
      <value>
        <researchPrerequisites Inherit="False">
          <li>Ferny_Column</li>
        </researchPrerequisites>
      </value>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>/Defs/ThingDef[defName="CE_Embrasure"]</xpath>
      <value>
        <researchPrerequisites Inherit="False">
          <li>Ferny_Column</li>
        </researchPrerequisites>
      </value>
    </nomatch>
  </Operation>
  <!-- Fine embrasure (VFE Architect + Royalty) takes the pretty wall's research -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="HRK_FineEmbrasure"]</xpath>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationRemove">
          <success>Always</success>
          <xpath>/Defs/ThingDef[defName="HRK_FineEmbrasure"]/researchPrerequisites</xpath>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>/Defs/ThingDef[defName="HRK_FineEmbrasure"]</xpath>
          <value>
            <researchPrerequisites Inherit="False">
              <li>Ferny_Column</li>
            </researchPrerequisites>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
  <!-- Rustic embrasure (ReBuild) takes the rustic wall's research: VFE Tribals' Construction, or none without VFE Tribals -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/VFETribals.TribalResearchProjectDef[defName="VFET_Construction"]</xpath>
    <match Class="PatchOperationConditional">
      <xpath>/Defs/ThingDef[defName="HRK_RusticEmbrasure"]</xpath>
      <match Class="PatchOperationSequence">
        <operations>
          <li Class="PatchOperationRemove">
            <success>Always</success>
            <xpath>/Defs/ThingDef[defName="HRK_RusticEmbrasure"]/researchPrerequisites</xpath>
          </li>
          <li Class="PatchOperationAdd">
            <xpath>/Defs/ThingDef[defName="HRK_RusticEmbrasure"]</xpath>
            <value>
              <researchPrerequisites Inherit="False">
                <li>VFET_Construction</li>
              </researchPrerequisites>
            </value>
          </li>
        </operations>
      </match>
    </match>
  </Operation>
</Patch>
