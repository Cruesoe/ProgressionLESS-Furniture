<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Hex tile and spikecore plates take the steel tile's research -->
  <Operation Class="PatchOperationRemove">
    <success>Always</success>
    <xpath>/Defs/TerrainDef[defName="Tile_Transhumanist" or defName="Plates_Spikecore"]/researchPrerequisites</xpath>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <success>Always</success>
    <xpath>/Defs/TerrainDef[defName="Tile_Transhumanist" or defName="Plates_Spikecore"]</xpath>
    <value>
      <researchPrerequisites Inherit="False">
        <li>Ferny_Floors</li>
        <li>Smithing</li>
      </researchPrerequisites>
    </value>
  </Operation>
</Patch>
