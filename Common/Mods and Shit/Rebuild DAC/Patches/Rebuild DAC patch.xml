<?xml version="1.0" encoding="utf-8" ?>
<Patch>              
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Vanilla Furniture Expanded - Architect</li>
		</mods>
		<match Class="PatchOperationSequence">
    <operations>


    <li Class="PatchOperationAddModExtension">
        <success>Always</success>
        <xpath>/Defs/ThingDef[defName="RB_CellWall"]</xpath>
        <value>
			<li Class="VFEArchitect.BuildingExtension_PrisonerProof"></li>
        </value>
    </li>




                <li Class="PatchOperationReplace">
                    <xpath>Defs/ThingDef[defName="RB_CellWall"]/researchPrerequisites</xpath>
                    <value>
                        <researchPrerequisites>
                        	<li>Ferny_WindowWall</li>
                        	<li>Smithing</li>
                        </researchPrerequisites>
                    </value>
                </li>

    </operations>
		</match>
	</Operation>








	<!-- One basic wall in Construction: Medieval Overhaul keeps its log wall and hides the rustic wall, otherwise ReBuild's rustic wall replaces VFE Architect's log wall -->
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Medieval Overhaul</li>
		</mods>
		<match Class="PatchOperationConditional">
			<xpath>Defs/ThingDef[defName="RB_RusticWall"]/designationCategory</xpath>
			<match Class="PatchOperationReplace">
				<xpath>Defs/ThingDef[defName="RB_RusticWall"]/designationCategory</xpath>
				<value>
					<designationCategory IsNull="True" />
				</value>
			</match>
			<nomatch Class="PatchOperationAdd">
				<xpath>Defs/ThingDef[defName="RB_RusticWall"]</xpath>
				<value>
					<designationCategory IsNull="True" />
				</value>
			</nomatch>
		</match>
		<nomatch Class="PatchOperationFindMod">
			<mods>
				<li>Vanilla Furniture Expanded - Architect</li>
			</mods>
			<match Class="PatchOperationConditional">
				<xpath>Defs/ThingDef[defName="VFEArch_LogWall"]/designationCategory</xpath>
				<match Class="PatchOperationReplace">
					<xpath>Defs/ThingDef[defName="VFEArch_LogWall"]/designationCategory</xpath>
					<value>
						<designationCategory IsNull="True" />
					</value>
				</match>
				<nomatch Class="PatchOperationAdd">
					<xpath>Defs/ThingDef[defName="VFEArch_LogWall"]</xpath>
					<value>
						<designationCategory IsNull="True" />
					</value>
				</nomatch>
			</match>
		</nomatch>
	</Operation>

	<!-- Fine wood floor builds with the other fine floors; Progression: Core gives it VFE Tribals' Construction -->
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/TerrainDef[@Name="RB_FinePlankWoodBase"]/researchPrerequisites</xpath>
		<match Class="PatchOperationReplace">
			<xpath>Defs/TerrainDef[@Name="RB_FinePlankWoodBase"]/researchPrerequisites</xpath>
			<value>
				<researchPrerequisites Inherit="False">
					<li>Ferny_Floors</li>
				</researchPrerequisites>
			</value>
		</match>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/TerrainDef[@Name="RB_FinePlankWoodBase"]</xpath>
			<value>
				<researchPrerequisites Inherit="False">
					<li>Ferny_Floors</li>
				</researchPrerequisites>
			</value>
		</nomatch>
	</Operation>
</Patch>
