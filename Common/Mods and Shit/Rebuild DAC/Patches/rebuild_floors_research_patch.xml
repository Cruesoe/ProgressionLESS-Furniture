<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Wood hex floor (ReBuild + Ideology) takes the wood floor's research -->
  <Operation Class="PatchOperationRemove">
    <success>Always</success>
    <xpath>/Defs/TerrainDef[defName="RB_WoodPlankFloor_Transhumanist"]/researchPrerequisites</xpath>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <success>Always</success>
    <xpath>/Defs/TerrainDef[defName="RB_WoodPlankFloor_Transhumanist"]</xpath>
    <value>
      <researchPrerequisites Inherit="False">
        <li>Ferny_Column</li>
      </researchPrerequisites>
    </value>
  </Operation>
</Patch>
