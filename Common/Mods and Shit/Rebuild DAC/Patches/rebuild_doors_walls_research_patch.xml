<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationSequence">
    <operations>
      <li Class="PatchOperationRemove">
        <success>Always</success>
        <xpath>/Defs/ThingDef[defName="RB_DoubleDoor"]/researchPrerequisites</xpath>
      </li>
      <li Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="RB_DoubleDoor"]</xpath>
        <value>
          <researchPrerequisites Inherit="False">
            <li>Ferny_Column</li>
          </researchPrerequisites>
        </value>
      </li>
    </operations>
  </Operation>
  <!-- Rustic wall takes the log wall's research: VFE Tribals' Construction, or none without VFE Tribals -->
  <Operation Class="PatchOperationRemove">
    <success>Always</success>
    <xpath>/Defs/ThingDef[defName="RB_RusticWall"]/researchPrerequisites</xpath>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ResearchProjectDef[defName="VFET_Construction"]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>/Defs/ThingDef[defName="RB_RusticWall"]</xpath>
      <value>
        <researchPrerequisites Inherit="False">
          <li>VFET_Construction</li>
        </researchPrerequisites>
      </value>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>/Defs/ThingDef[defName="RB_RusticWall"]</xpath>
      <value>
        <researchPrerequisites Inherit="False" />
      </value>
    </nomatch>
  </Operation>
  <Operation Class="PatchOperationSequence">
    <operations>
      <li Class="PatchOperationRemove">
        <success>Always</success>
        <xpath>/Defs/ThingDef[defName="RB_LargeOrnateDoor"]/researchPrerequisites</xpath>
      </li>
      <li Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="RB_LargeOrnateDoor"]</xpath>
        <value>
          <researchPrerequisites Inherit="False">
            <li>Ferny_WindowWall</li>
            <li>Ferny_Column</li>
          </researchPrerequisites>
        </value>
      </li>
    </operations>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName="RB_LargeOrnateDoor"]/label</xpath>
    <value>
      <label>ornate door (1x3)</label>
    </value>
  </Operation>
</Patch>
