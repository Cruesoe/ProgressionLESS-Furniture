<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!-- VFE Classical crafting bench follows the tables chain -->
  <Operation Class="PatchOperationRemove">
    <success>Always</success>
    <xpath>/Defs/ResearchProjectDef[defName="VFEC_CraftingBench"]/prerequisites</xpath>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ResearchProjectDef[defName="VFEC_CraftingBench"]</xpath>
    <value>
      <prerequisites>
        <li>Ferny_Tables</li>
      </prerequisites>
    </value>
  </Operation>

  <Operation Class="PatchOperationRemove">
    <success>Always</success>
    <xpath>/Defs/ThingDef[defName="VFEC_CraftingBench"]/researchPrerequisites</xpath>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName="VFEC_CraftingBench"]</xpath>
    <value>
      <researchPrerequisites Inherit="False">
        <li>Ferny_Tables</li>
      </researchPrerequisites>
    </value>
  </Operation>
</Patch>
