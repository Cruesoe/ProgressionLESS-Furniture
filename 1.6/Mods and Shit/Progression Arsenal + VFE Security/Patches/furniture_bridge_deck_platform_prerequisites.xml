<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<Operation Class="PatchOperationRemove">
		<success>Always</success>
		<xpath>/Defs/ResearchProjectDef[defName="Ferny_Bridge" or defName="Ferny_Deck"]/prerequisites</xpath>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>/Defs/ResearchProjectDef[defName="Ferny_Bridge" or defName="Ferny_Deck"]</xpath>
		<value>
			<prerequisites Inherit="False">
				<li>Ferny_Platform</li>
			</prerequisites>
		</value>
	</Operation>
</Patch>
