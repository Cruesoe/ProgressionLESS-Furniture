<?xml version="1.0" encoding="utf-8" ?>

<Patch>

    <!-- Window wall research -->
    <Operation Class="PatchOperationAdd">
        <xpath>/Defs</xpath>
        <value>
            <ResearchProjectDef>
                <defName>Ferny_WindowWall</defName>
                <label>window wall</label>
                <description>Build glass wall sections that let light and sight through while enclosing a room.</description>
                <baseCost>300</baseCost>
                <techLevel>Medieval</techLevel>
                <researchViewX>2.00</researchViewX>
                <researchViewY>2.00</researchViewY>
                <prerequisites>
                    <li>Smithing</li>
                </prerequisites>
            </ResearchProjectDef>
        </value>
    </Operation>

    <!-- Rename ReBuild glass walls into window walls -->
    <Operation Class="PatchOperationReplace">
        <xpath>/Defs/ThingDef[defName="RB_GlassWall"]/label</xpath>
        <value>
            <label>window wall</label>
        </value>
    </Operation>

    <Operation Class="PatchOperationReplace">
        <xpath>/Defs/ThingDef[defName="RB_ReinforcedGlassWall"]/label</xpath>
        <value>
            <label>reinforced window wall</label>
        </value>
    </Operation>

    <!-- Window wall family research -->
    <Operation Class="PatchOperationReplace">
        <xpath>/Defs/ThingDef[defName="RB_GlassWall"]/researchPrerequisites</xpath>
        <value>
            <researchPrerequisites Inherit="False">
                <li>Ferny_WindowWall</li>
            </researchPrerequisites>
        </value>
    </Operation>

    <Operation Class="PatchOperationReplace">
        <xpath>/Defs/ThingDef[defName="RB_ReinforcedGlassWall"]/researchPrerequisites</xpath>
        <value>
            <researchPrerequisites Inherit="False">
                <li>Ferny_WindowWall</li>
            </researchPrerequisites>
        </value>
    </Operation>

    <Operation Class="PatchOperationReplace">
        <xpath>/Defs/ThingDef[defName="RB_ClerestoryWall"]/researchPrerequisites</xpath>
        <value>
            <researchPrerequisites Inherit="False">
                <li>Ferny_WindowWall</li>
            </researchPrerequisites>
        </value>
    </Operation>

    <Operation Class="PatchOperationReplace">
        <xpath>/Defs/ThingDef[defName="RB_ReinforcedClerestoryWall"]/researchPrerequisites</xpath>
        <value>
            <researchPrerequisites Inherit="False">
                <li>Ferny_WindowWall</li>
            </researchPrerequisites>
        </value>
    </Operation>

</Patch>
