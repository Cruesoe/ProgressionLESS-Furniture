<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Vanilla Factions Expanded - Tribals</li>
		</mods>
		<match Class="PatchOperationConditional">
			<xpath>/Defs/ResearchProjectDef[defName="RBPClassicalPainting"]/prerequisites</xpath>
			<match Class="PatchOperationAdd">
				<xpath>/Defs/ResearchProjectDef[defName="RBPClassicalPainting"]/prerequisites</xpath>
				<value>
					<li>VFET_Culture</li>
				</value>
			</match>
			<nomatch Class="PatchOperationAdd">
				<xpath>/Defs/ResearchProjectDef[defName="RBPClassicalPainting"]</xpath>
				<value>
					<prerequisites>
						<li>VFET_Culture</li>
					</prerequisites>
				</value>
			</nomatch>
		</match>
	</Operation>
</Patch>
