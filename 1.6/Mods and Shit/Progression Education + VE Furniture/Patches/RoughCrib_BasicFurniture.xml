<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Loads with Education and VE Furniture but not Medieval Overhaul: the rough crib folds into Basic furniture -->
  <Operation Class="PatchOperationSequence">
    <operations>
      <li Class="PatchOperationReplace">
        <success>Always</success>
        <xpath>Defs//*[self::researchPrerequisites or self::prerequisites or self::hiddenPrerequisites]/li[normalize-space(text())="Ferny_RoughCrib"]</xpath>
        <value>
          <li>MF_BasicFurniture</li>
        </value>
      </li>
      <li Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="TribalCrib"]/researchPrerequisites</xpath>
        <value>
          <researchPrerequisites Inherit="False">
            <li>MF_BasicFurniture</li>
            <li MayRequire="oskarpotocki.vfe.tribals">VFET_Furniture</li>
          </researchPrerequisites>
        </value>
      </li>
      <li Class="PatchOperationRemove">
        <xpath>Defs/ResearchProjectDef[defName="Ferny_RoughCrib"]</xpath>
      </li>
    </operations>
  </Operation>
</Patch>
